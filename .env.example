# ---------------------------------------------------------------------------
# Document Insights API - environment configuration
#
# Copy this file to `.env` and adjust values as needed:
#     cp .env.example .env
#
# These variables are consumed by the FastAPI service, the background worker,
# and (via docker-compose) passed into the containers.
# ---------------------------------------------------------------------------

# --- Network / server -------------------------------------------------------
# Interface the API binds to inside the container (0.0.0.0 = all interfaces).
HOST=0.0.0.0
# Port the API serves on inside the container.
PORT=8000

# --- MongoDB -----------------------------------------------------------------
# Connection string for the MongoDB instance. docker-compose exposes it on port 27017.
MONGODB_URI=mongodb://mongo:27017
# Database name used by the application.
MONGODB_DB=document_insights
# Collection names (override only if you change the data model).
DOCUMENTS_COLLECTION=documents

# --- Redis -------------------------------------------------------------------
# Redis connection URL. docker-compose exposes it on port 6379.
REDIS_URL=redis://redis:6379/0
# TTL (seconds) for content-hash cache entries. 1 hour by default.
CACHE_TTL_SECONDS=3600
# Redis DB index to use when the same URL is shared across services.
# REDIS_DB=0

# --- Background worker -------------------------------------------------------
# How many documents the worker processes concurrently.
WORKER_CONCURRENCY=8

# Simulated processing time window (seconds) for a mock job.
JOB_MIN_SECONDS=10
JOB_MAX_SECONDS=30
# Approximate probability (0.0-1.0) that a job fails (for testing error handling).
JOB_FAILURE_RATE=0.1
JOB_PERMANENT_FAILURE_ON_RETRY=False

# --- Rate limiting (per user) ------------------------------------------------
# Maximum number of documents a user may have queued/processing at once.
MAX_ACTIVE_PER_USER=3
# TTL (ms) for per-user single-flight lock lock:submit:{user_id}:{hash} (covers insert+enqueue p99).
SUBMIT_LOCK_TTL_MS=10000

# --- Application -------------------------------------------------------------
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Environment name: development | production
APP_ENV=development
